# Read-only Snowflake profile for the Retail Business Dashboard
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=retail_dashboard_reader
SNOWFLAKE_ROLE=RETAIL_DASHBOARD_READ_ROLE
SNOWFLAKE_WAREHOUSE=SALES_WH
SNOWFLAKE_DATABASE=DATA_MART
SNOWFLAKE_SCHEMA=RETAIL_DASHBOARD

# Recommended for a shared/service user. Keep the complete PKCS#8 PEM on one
# line and replace every original line break with the two characters \n.
SNOWFLAKE_AUTH=keypair
SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<private-key-body>\n-----END PRIVATE KEY-----"
# Only needed when the private key itself is encrypted:
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Alternatives supported by the script:
# SNOWFLAKE_AUTH=externalbrowser
# SNOWFLAKE_AUTH=password
# SNOWFLAKE_PASSWORD=
